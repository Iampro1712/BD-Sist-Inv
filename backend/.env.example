# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Ajusta estos valores según tu configuración
DATABASE_URL=postgresql://user:password@host:port/database

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache (Redis) - opcional. Si se omite, se usa cache en memoria local.
REDIS_URL=redis://default:password@host:port

# Actualizaciones de la app de escritorio (Inventrix Desktop)
#
# El repositorio del escritorio es privado, así que el backend hace de
# intermediario para que la app no tenga que llevar un token dentro del .exe.
#
# El token debe ser fine-grained, con permiso "Contents: Read-only" y limitado
# SOLO al repositorio del escritorio. Se genera en:
#   GitHub > Settings > Developer settings > Personal access tokens
#           > Fine-grained tokens > Generate new token
#
# Si se dejan vacías, /api/desktop/version/ responde 503 y la app simplemente
# no busca actualizaciones (no se rompe nada).
GITHUB_DESKTOP_REPO=usuario/Inventrix-java
GITHUB_DESKTOP_TOKEN=github_pat_...
